{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gargand-cloudflare-stage",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PORT": "10000",
    "PYTHONUNBUFFERED": "1",
    "GARGAND_WEBSITE_URL": "https://gargand-cloudflare-stage.popescuulucaap.workers.dev",
    "NIGHTFALL_WEBSITE_URL": "https://gargand-cloudflare-stage.popescuulucaap.workers.dev",
    "DISCORD_REDIRECT_URI": "https://gargand-cloudflare-stage.popescuulucaap.workers.dev/oauth/callback",
    "ROBLOX_OAUTH_REDIRECT_URI": "https://gargand-cloudflare-stage.popescuulucaap.workers.dev/roblox/callback"
  },
  "containers": [
    {
      "class_name": "GargandContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GARGAND",
        "class_name": "GargandContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GargandContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
